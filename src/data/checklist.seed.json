[
  { "id": 1, "title": "4년 과목 플랜 짜기 — 수학 트랙부터 확인", "why_how": "12학년까지 Calculus 도달 경로가 여기서 결정됨 — 학교 수학 시퀀스를 확인하고, 경로가 안 나오면 여름 보강 계획을 지금 세울 것", "grade": 9, "season": "fall", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "rigor", "is_guide": false, "sort_order": 10 },
  { "id": 2, "title": "GPA 루틴 만들기", "why_how": "9학년 성적도 GPA에 그대로 들어감 — 과제·시험 준비 루틴은 첫 학기에 잡는 게 가장 쉽고, 상승 곡선의 시작점이 됨", "grade": 9, "season": "fall", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "rigor", "is_guide": false, "sort_order": 20 },
  { "id": 3, "title": "성격이 다른 활동 2~3개 시도", "why_how": "지금은 잘하는 것보다 계속하고 싶은 걸 찾는 시기 — 만들기형·사람형·쓰기형처럼 유형을 다르게 골라볼 것", "grade": 9, "season": "fall", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "spike", "is_guide": true, "sort_order": 30 },
  { "id": 4, "title": "학교의 국제 인증(WASC·Cognia 등)과 school profile 존재 확인", "why_how": "성적표의 대외 신뢰도를 좌우하는 정보 — 학교 행정실에 직접 물어보고, 없다면 AP·SAT 등 외부 지표 비중을 높이는 전략으로", "grade": 9, "season": "fall", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": true, "axis": "story", "is_guide": false, "sort_order": 40 },
  { "id": 5, "title": "영어 노출량 늘리기 (시험 말고 기반)", "why_how": "TOEFL은 아직 멀었음 — 지금은 관심 분야의 영어 콘텐츠를 일상으로 소비하는 습관이 나중의 점수를 만듦", "grade": 9, "season": "fall", "major_category": null, "tier_condition": null, "intl_only": true, "no_counselor_only": false, "axis": "testing", "is_guide": false, "sort_order": 50 },
  { "id": 6, "title": "10학년 과목 신청 — Honors 도전 포함", "why_how": "리거는 학년마다 한 계단씩 올라가는 그림이 이상적 — 감당 가능한 선에서 Honors를 1~2개 넣을 것", "grade": 9, "season": "spring", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "rigor", "is_guide": false, "sort_order": 10 },
  { "id": 7, "title": "시도한 활동 거르기 — 계속할 것만 남기기", "why_how": "전부 유지하면 전부 얕아짐 — \"다음 학기에도 하고 싶은가\"로 판단해 2개 이내로", "grade": 9, "season": "spring", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "spike", "is_guide": true, "sort_order": 20 },
  { "id": 8, "title": "여름 계획 세우기", "why_how": "9학년 여름은 부담 없는 탐색이 정답 — 무료·자기주도 활동 하나면 충분하고, 비싼 캠프가 필요한 시기가 아님", "grade": 9, "season": "spring", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "spike", "is_guide": true, "sort_order": 30 },
  { "id": 9, "title": "첫해 성적 점검 — 약한 과목 보강 계획", "why_how": "AO는 추세를 봄 — 9학년에 흔들린 과목은 10학년 상승으로 덮을 수 있으니 지금 원인을 찾을 것", "grade": 9, "season": "spring", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "rigor", "is_guide": false, "sort_order": 40 },
  { "id": 10, "title": "관심 분야 탐색 활동 1개 실행", "why_how": "결과물이 없어도 됨 — \"이 분야가 나랑 맞는지\" 확인이 이번 여름의 목표", "grade": 9, "season": "summer", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "spike", "is_guide": true, "sort_order": 10 },
  { "id": 11, "title": "관심 분야 독서·기록 습관", "why_how": "읽고 남긴 기록이 나중에 에세이 재료가 됨 — 짧은 감상이라도 남길 것", "grade": 9, "season": "summer", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "story", "is_guide": true, "sort_order": 20 },
  { "id": 12, "title": "PSAT 연습 응시", "why_how": "점수가 아니라 형식 경험이 목적 — 실전 감각은 한 번의 경험으로 크게 달라짐", "grade": 10, "season": "fall", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "testing", "is_guide": false, "sort_order": 10 },
  { "id": 13, "title": "첫 AP/Honors 과목 안착", "why_how": "어려워진 과목에서 성적을 지키는 게 이번 학기 최우선 — 리거 상승과 GPA 유지를 동시에 잡는 연습", "grade": 10, "season": "fall", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "rigor", "is_guide": false, "sort_order": 20 },
  { "id": 14, "title": "활동 몰입 시작 — 넓히는 시기는 끝", "why_how": "이제부터는 남긴 활동을 깊게 파는 구간 — 새 활동 추가는 기존 것과 연결될 때만", "grade": 10, "season": "fall", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "spike", "is_guide": true, "sort_order": 30 },
  { "id": 15, "title": "추천서 후보 교사와 수업 안에서 신뢰 쌓기", "why_how": "추천서는 벼락치기가 안 됨 — 11학년에 부탁할 교사 후보를 정하고 질문·참여로 기억에 남는 학생이 될 것", "grade": 10, "season": "fall", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": true, "axis": "story", "is_guide": false, "sort_order": 40 },
  { "id": 16, "title": "11학년 AP 라인업 확정", "why_how": "AP는 전년도에 신청함 — 전공 관련 핵심 AP가 포함됐는지, 미개설이면 자습 응시 계획까지 이번 달에 결정", "grade": 10, "season": "spring", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "rigor", "is_guide": false, "sort_order": 10 },
  { "id": 17, "title": "AP 시험 응시 (수강 중이라면)", "why_how": "첫 AP 점수는 실전 리허설 — 5점이면 좋지만 시험 운영 경험 자체가 11학년 다과목 시즌의 자산", "grade": 10, "season": "spring", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "testing", "is_guide": false, "sort_order": 20 },
  { "id": 18, "title": "SAT 공부 시작 시점 결정", "why_how": "표준 리듬은 10학년 여름 시작 → 11학년 가을 1차 응시 — 목표 티어가 높을수록 이 리듬을 지킬 것", "grade": 10, "season": "spring", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "testing", "is_guide": false, "sort_order": 30 },
  { "id": 19, "title": "여름 심화 활동 확정", "why_how": "10학년 여름은 스파이크 만들기의 마지노선 — 프로젝트·리서치·봉사 중 하나를 구체적 계획으로", "grade": 10, "season": "spring", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "spike", "is_guide": true, "sort_order": 40 },
  { "id": 20, "title": "심화 활동 착수", "why_how": "참가가 아니라 만들기 — 여름이 끝날 때 \"보여줄 수 있는 것\"이 하나 남는 걸 목표로", "grade": 10, "season": "summer", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "spike", "is_guide": true, "sort_order": 10 },
  { "id": 21, "title": "SAT 기초 학습 시작", "why_how": "진단 모의고사로 시작점 확인 → 약점 영역 중심 학습 — 무료 공식 자료(Khan Academy)로 충분한 단계", "grade": 10, "season": "summer", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "testing", "is_guide": false, "sort_order": 20 },
  { "id": 22, "title": "TOEFL 필요 여부 판단", "why_how": "목표 학교마다 면제 기준이 다름 — 국제학교 재학 연수로 면제되는 학교도 있으니 목표 리스트 기준으로 확인 후 계획", "grade": 10, "season": "summer", "major_category": null, "tier_condition": null, "intl_only": true, "no_counselor_only": false, "axis": "testing", "is_guide": false, "sort_order": 30 },
  { "id": 23, "title": "PSAT 실전 응시", "why_how": "11학년 PSAT는 실전 — SAT 직전 리허설이자 현재 위치 확인", "grade": 11, "season": "fall", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "testing", "is_guide": false, "sort_order": 10 },
  { "id": 24, "title": "SAT 1차 응시 등록·응시", "why_how": "가을 1차 → 봄 재응시가 표준 — 1차를 미루면 재응시 기회가 사라짐, 응시 장소는 미리 확보", "grade": 11, "season": "fall", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "testing", "is_guide": false, "sort_order": 20 },
  { "id": 25, "title": "AP 다과목 관리 루틴 세우기", "why_how": "11학년은 최대 하중의 해 — 과목별 주간 루틴 없이는 전 과목이 같이 흔들림", "grade": 11, "season": "fall", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "rigor", "is_guide": false, "sort_order": 30 },
  { "id": 26, "title": "리더십 포지션 확보 또는 직접 만들기", "why_how": "AO는 직함보다 만든 것을 봄 — 기존 클럽 임원이 어려우면 작게라도 직접 만들 것", "grade": 11, "season": "fall", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "leadership", "is_guide": true, "sort_order": 40 },
  { "id": 27, "title": "외부 검증 도전 — 대회·투고 마감 확인", "why_how": "원서에 들어갈 수확의 마지막 해 — 지금 마감 캘린더를 만들어야 봄의 기회를 놓치지 않음", "grade": 11, "season": "fall", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "validation", "is_guide": true, "sort_order": 50 },
  { "id": 28, "title": "추천서 교사 2명 내정", "why_how": "12학년 가을에 부탁하면 늦음 — 지금부터 그 수업에서 추천서에 쓸 재료(질문·프로젝트·성장)를 만들 것", "grade": 11, "season": "fall", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": true, "axis": "story", "is_guide": false, "sort_order": 60 },
  { "id": 29, "title": "SAT 재응시·마무리", "why_how": "봄 안에 끝내는 게 목표 — 여름·가을은 에세이와 원서의 시간", "grade": 11, "season": "spring", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "testing", "is_guide": false, "sort_order": 10 },
  { "id": 30, "title": "AP 시험 시즌 운영", "why_how": "다과목 시험은 체력전 — 과목별 우선순위를 정하고 전공 관련 과목에 5점을 집중", "grade": 11, "season": "spring", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "testing", "is_guide": false, "sort_order": 20 },
  { "id": 31, "title": "대학 리스트 초안 만들기", "why_how": "reach/match/safety 균형이 핵심 — 툴의 둘러보기와 내 위치 마커로 각 그룹 3~4개씩", "grade": 11, "season": "spring", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "story", "is_guide": false, "sort_order": 30 },
  { "id": 32, "title": "TOEFL 마무리", "why_how": "SAT와 원서가 몰리기 전에 끝낼 것 — 여름 이후로 밀리면 일정이 겹침", "grade": 11, "season": "spring", "major_category": null, "tier_condition": null, "intl_only": true, "no_counselor_only": false, "axis": "testing", "is_guide": false, "sort_order": 40 },
  { "id": 33, "title": "추천서 공식 부탁", "why_how": "학년이 끝나기 전 부탁이 예의이자 안전 — 교사가 여름에 쓸 시간을 확보해주는 것", "grade": 11, "season": "spring", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "story", "is_guide": false, "sort_order": 50 },
  { "id": 34, "title": "원서 메인 에세이 초안 완성", "why_how": "12학년 가을엔 쓸 시간이 없음 — 여름 초안, 가을 퇴고가 표준 리듬", "grade": 11, "season": "summer", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "story", "is_guide": false, "sort_order": 10 },
  { "id": 35, "title": "대표 활동 마무리·정리", "why_how": "스파이크를 \"보여줄 수 있는 형태\"로 — 결과물·숫자·기록을 지금 정리해야 활동란이 쉬워짐", "grade": 11, "season": "summer", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "spike", "is_guide": true, "sort_order": 20 },
  { "id": 36, "title": "대학 리스트 확정 + ED/EA 전략 결정", "why_how": "ED는 합격 시 등록 의무가 있는 카드 — 진짜 1지망과 재정 조건을 함께 고려해 결정", "grade": 11, "season": "summer", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "story", "is_guide": false, "sort_order": 30 },
  { "id": 37, "title": "재정 서류 준비 논의 시작", "why_how": "은행잔고증명 등은 부모님과 시간이 필요한 서류 — need-aware 학교 지원 전략과도 연결되니 여름에 논의 시작", "grade": 11, "season": "summer", "major_category": null, "tier_condition": null, "intl_only": true, "no_counselor_only": false, "axis": "story", "is_guide": false, "sort_order": 40 },
  { "id": 38, "title": "Common App 계정 생성·활동란 초안", "why_how": "활동란 10칸은 생각보다 오래 걸림 — 각 활동을 150자로 압축하는 연습을 지금", "grade": 11, "season": "summer", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "story", "is_guide": false, "sort_order": 50 },
  { "id": 39, "title": "ED/EA 원서 제출 — 마감 역산 관리", "why_how": "마감일이 아니라 발송 완료일 기준으로 역산 — 추천서·성적표는 내가 아니라 남이 보내는 것이므로 여유가 필수", "grade": 12, "season": "fall", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "story", "is_guide": false, "sort_order": 10 },
  { "id": 40, "title": "메인 에세이 완성 + 보충 에세이 착수", "why_how": "보충 에세이가 진짜 분량 — 학교별 문항을 스프레드시트로 정리하면 겹치는 주제를 재활용할 수 있음", "grade": 12, "season": "fall", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": false, "axis": "story", "is_guide": false, "sort_order": 20 },
  { "id": 41, "title": "성적표·추천서 발송 확인 — 담당자 직접 지정", "why_how": "전담 카운슬러가 없으면 발송 주체가 불분명해짐 — 누가 언제 보내는지 이름과 날짜로 확정할 것", "grade": 12, "season": "fall", "major_category": null, "tier_condition": null, "intl_only": false, "no_counselor_only": true, "axis": "story", "is_guide": false, "sort_order": 30 },
  { "id": 42, "title": "CSS Profile·재정증명 제출", "why_how": "재정지원 서류는 원서와 마감이 다름 — 학교별 요구 서류와 마감을 따로 관리", "grade": 12, "season": "fall", "major_category": null, "tier_condition": null, "intl_only": true, "no_counselor_only": false, "axis": "story", "is_guide": false, "sort_order": 40 },
